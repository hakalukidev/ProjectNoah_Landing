# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# admin panel data: categories/images/contact JSON + uploaded photos
/data/
/public/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pristine originals stashed by scripts/watermark-static.mjs before it burns
# the watermark into public/works and public/site-photos in place
/.watermark-originals/

# raw unedited clips dropped in for reference; the site serves /video1..5.mp4
# from the public root instead, so these never need to ship
/public/project_images/*.mp4
